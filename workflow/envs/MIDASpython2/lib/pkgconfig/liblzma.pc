prefix=/dfs7/xuek5-lab/aespelet/envs/MIDASpython2
exec_prefix=/dfs7/xuek5-lab/aespelet/envs/MIDASpython2
libdir=/dfs7/xuek5-lab/aespelet/envs/MIDASpython2/lib
includedir=/dfs7/xuek5-lab/aespelet/envs/MIDASpython2/include

Name: liblzma
Description: General purpose data compression library
URL: https://tukaani.org/xz/
Version: 5.2.5
Cflags: -I${includedir}
Libs: -L${libdir} -llzma
Libs.private: -pthread -lrt  -lpthread
